# Supabase — Project Settings > API
# Cercado de Lima y Villa El Salvador son 2 instancias/deploys SEPARADOS, cada uno
# con su PROPIO proyecto Supabase (URL + anon key distintos).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Ámbito operado por esta instancia (opcional — si se omite, cae a Cercado de Lima).
# El distrito se guarda con su nombre oficial de ubigeo ("Lima"), no el alias
# "Cercado de Lima" (así calza con el padrón de CALI.xlsx / ONPE).
VITE_AMBITO_DEPARTAMENTO=Lima
VITE_AMBITO_PROVINCIAS=Lima
VITE_AMBITO_DISTRITOS=Lima
VITE_AMBITO_TOKEN_PREFIX=CDL2026

# Para la instancia de Villa El Salvador, usar en su lugar:
# VITE_AMBITO_DEPARTAMENTO=Lima
# VITE_AMBITO_PROVINCIAS=Lima
# VITE_AMBITO_DISTRITOS=Villa El Salvador
# VITE_AMBITO_TOKEN_PREFIX=VES2026
