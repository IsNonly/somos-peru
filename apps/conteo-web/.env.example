# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Ámbito operado por esta instancia (opcional — si se omite, cae a Cercado de Lima + Villa El Salvador).
# Cada provincia/distrito nuevo usa estas variables (comparten el mismo proyecto Supabase).
VITE_AMBITO_DEPARTAMENTO=Lima
VITE_AMBITO_PROVINCIAS=Lima
VITE_AMBITO_DISTRITOS=Cercado de Lima,Villa El Salvador
