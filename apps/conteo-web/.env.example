# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Ámbito operado por esta instancia (opcional — si se omite, cae a Tumbes).
# Cada provincia/distrito nuevo usa su propio proyecto Supabase + estas variables.
VITE_AMBITO_DEPARTAMENTO=Tumbes
VITE_AMBITO_PROVINCIAS=Tumbes,Zarumilla,Contralmirante Villar
VITE_AMBITO_DISTRITOS=Tumbes,Corrales,La Cruz,Pampas de Hospital,San Jacinto,San Juan de la Virgen,Zorritos,Casitas,Canoas de Punta Sal,Zarumilla,Matapalo,Papayal,Aguas Verdes
