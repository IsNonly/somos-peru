# Supabase — Project Settings > API
# Cercado de Lima y Villa El Salvador son 2 instancias/deploys SEPARADOS, cada uno
# con su PROPIO proyecto Supabase (URL + anon key distintos).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL de la app de registro/capacitación (para mandar al personero a completar los pasos)
VITE_CAPACITACION_URL=http://localhost:5173/capacitate

# URL del panel web (para mandar ahí a coordinadores/admin)
VITE_PANEL_URL=http://localhost:5175

# Ámbito operado por esta instancia (opcional — si se omite, cae a Cercado de Lima).
# Cercado de Lima y Villa El Salvador son 2 instancias/deploys SEPARADOS.
# Para la instancia de Villa El Salvador: VITE_AMBITO_DEPARTAMENTO=Lima (sin cambio).
VITE_AMBITO_DEPARTAMENTO=Lima
